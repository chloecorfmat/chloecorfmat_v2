<div class="contact-hero">
  <div class="block">
    <div class="contact-hero__col">
      {% set media = hero.photo %}
      {% if media.field_media_image.entity %}
        {% set uri = media.field_media_image.entity.uri.value %}
        {% set alt = media.field_media_image.alt %}
        <div class="img__container">
          <img
            src="{{ file_url(uri) }}"
            alt=""
          >
        </div>
      {% endif %}
    </div>
    <div class="contact-hero__col">
      <h1>{{ hero.title }}</h1>
      <p>{{ hero.text|raw }}</p>

      <!-- Callout -->
      <div class="contact-hero__callout">
        <div class="wysiwyg fs-lg">
          {{ hero.callout|raw }}
        </div>
      </div>
    </div>
  </div>
  <div class="contact-hero__background">
  </div>
</div>

<div class="contact-discovery-call">
  <div class="block">
    <div class="contact-discovery-call__container">
      <h2>{{ discoveryCall.title }}</h2>
      <div class="wysiwyg fs-lg">
        {{ discoveryCall.text|raw }}
      </div>
      <a href="{{ discoveryCall.cta.url }}" target="{{ '_' ~ discoveryCall.cta.target }}" class="btn btn--{{ discoveryCall.cta.color }}">
        {{ discoveryCall.cta.text }}
      </a>
    </div>
  </div>
</div>

<div class="contact-contact">
  <div class="block">
    <img src="/themes/custom/cco_theme/assets/asset-mascotte-contact.png" alt="" class="contact-contact__mascotte">
    <div class="contact-contact__content">
      <div class="contact-contact__form">
        <h2>{{ contact.form.title }}</h2>
        <div class="wysiwyg fs-lg">
          <p>Tous les champs sont obligatoires.</p>
        </div>
        {{ contact.form.form }}


      </div>
      <div class="contact-contact__text">
        <div class="contact-contact__others">
          <h3>{{ contact.others.title }}</h3>
          <div class="wysiwyg">
            {{ contact.others.text|raw }}
          </div>
        </div>

        <div class="contact-contact__social">
          <h3>{{ contact.social.title }}</h3>
          {% if contact.social.platforms is not empty %}
            <ul class="contact-contact__social-list">
              {% for platform in contact.social.platforms %}
                <li class="contact-contact__social-item">
                  <a href="{{ platform.url }}" target="_blank" title="{{ platform.name ~ ' - Nouvelle fenêtre' }}">
                    <img src="{{ file_url(platform.logo) }}" alt="{{ platform.name }}">
                  </a>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>

        <img src="/themes/custom/cco_theme/assets/asset-sticker-computer-white.png" alt="" class="contact-contact__computer">
      </div>
    </div>
  </div>
</div>
