<div class="pg-callout">
  <div class="block">
    <div class="pg-callout__container">
      <div class="pg-callout__content">
        <h2>{{ title }}</h2>
        <div class="wysiwyg fs-lg">
          {{ text|raw }}
        </div>

        {% if cta %}
          <a href="{{ cta.url }}" target="{{ '_' ~ cta.target }}" class="btn">
            {{ cta.text }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</div>
