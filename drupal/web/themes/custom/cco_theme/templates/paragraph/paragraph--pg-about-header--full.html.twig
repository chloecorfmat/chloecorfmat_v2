<div class="hp-about-header">
  <div class="block">
    <div class="hp-about-header__col">
        <div class="img__container">
          <img
            src="{{ file_url(photo) }}"
            alt=""
          >
        </div>
    </div>
    <div class="hp-about-header__col">
      <h1>{{ title }}</h1>
      <p>{{ text|raw }}</p>
    </div>
  </div>
  <div class="hp-about-header__background">
  </div>
</div>
