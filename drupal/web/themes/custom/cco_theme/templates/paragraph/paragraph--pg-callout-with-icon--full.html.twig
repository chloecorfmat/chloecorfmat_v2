<div class="pg-callout-with-icon block pg-callout-with-icon--{{ status }}">
  <div class="pg-callout-with-icon__container">
    <div class="pg-callout-with-icon__icon">
    <span class="pg-callout-with-icon__icon-image" aria-hidden="true">
      {{ icon }}
    </span>
    </div>
    <div class="pg-callout-with-icon__text">
      <div class="wysiwyg">
        {{ text|raw }}
      </div>
    </div>
  </div>
</div>
