<div class="pg-events" {% if anchor %} id="{{ anchor }}" {% endif %}>
  <div class="block">
    <div class="pg-events__header">
      <h2>{{ title }}</h2>
      <div class="wysiwyg fs-lg">
        {{ text|raw }}
      </div>
    </div>

    {{ content }}

    <div class="pg-events__footer">
      <div class="wysiwyg fs-lg">
        {{ ctaText|raw }}
      </div>
    </div>
  </div>
</div>
